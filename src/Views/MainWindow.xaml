<Window x:Class="Learnest.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Learnest"
        Width="1320" Height="860" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource LearnestShellWindow}"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.OnSurface}">

    <!-- Row 0 custom title bar · Row 1 navigation + content · Row 2 status strip -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Our own title bar.  The Windows one is suppressed by WindowChrome in
             Themes/Window.xaml (CaptionHeight=0), so this is the only title bar.
             Dragging is explicit, which also keeps double click to maximise working. -->
        <Border Grid.Row="0" x:Name="TitleBar" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MinHeight="48">
            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The shell keeps the simple "L" tile: the icon is used on the first-run wizard
                         and as the executable/installer icon, while the title bar stays a text mark. -->
                    <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource Brush.Primary}">
                        <TextBlock Text="L" Foreground="{DynamicResource Brush.OnPrimary}" FontWeight="Bold"
                                   FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppTitleText" Text="Learnest" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource Brush.OnSurface}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" x:Name="ContainerChip" Margin="14,0,0,0" VerticalAlignment="Center"
                        CornerRadius="9" Padding="9,4" Background="{DynamicResource Brush.SurfaceContainerHigh}">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="ContainerIcon" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.9"
                              Data="M4,6 L10,6 L12,9 L20,9 L20,19 L4,19 Z" VerticalAlignment="Center" />
                        <TextBlock x:Name="ContainerNameText" Margin="6,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource Brush.OnSurfaceVariant}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Global search.
                     Outline only, no fill: a filled Border with CornerRadius="9" and a 1px stroke fills
                     all the way to the border line while the stroke is drawn on a slightly larger arc,
                     so the fill leaked past the corners and read as a square block of background.
                     The TextBox keeps a real height and padding so a line of text fits comfortably. -->
                <Border Grid.Column="3" Width="280" Height="32" VerticalAlignment="Center" CornerRadius="10"
                        Background="Transparent"
                        BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1">
                    <Grid Margin="10,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.9"
                              Stroke="{DynamicResource Brush.OnSurfaceFaint}"
                              Data="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 M16,16 L21,21" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="GlobalSearchBox" Style="{StaticResource TextBox.Search}"
                                 Margin="8,0,0,0" Height="30" MinHeight="30" Padding="2,0" FontSize="12"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource Brush.OnSurface}"
                                 CaretBrush="{DynamicResource Brush.Primary}"
                                 VerticalContentAlignment="Center" TextChanged="GlobalSearchBox_TextChanged" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="ThemeButton" Style="{StaticResource TitleBarButton}" Click="ThemeButton_Click"
                            ToolTip="Theme">
                        <Path x:Name="ThemeIcon" Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{DynamicResource Brush.OnSurfaceVariant}"
                              Data="M12,7.5 A4.5,4.5 0 1 0 12,16.5 A4.5,4.5 0 1 0 12,7.5 M12,2 L12,4.5 M12,19.5 L12,22 M2,12 L4.5,12 M19.5,12 L22,12" />
                    </Button>
                    <Button x:Name="WidgetButton" Style="{StaticResource TitleBarButton}" Click="WidgetButton_Click"
                            ToolTip="Pin list widget">
                        <Path Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{DynamicResource Brush.OnSurfaceVariant}"
                              Data="M12,17 L12,22 M8,3 L16,3 L15,9 L18,12 L6,12 L9,9 Z" />
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource TitleBarButton}" Click="SettingsButton_Click"
                            ToolTip="Settings">
                        <Path Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.7"
                              Stroke="{DynamicResource Brush.OnSurfaceVariant}"
                              Data="M12,15.5 A3.5,3.5 0 1 0 12,8.5 A3.5,3.5 0 1 0 12,15.5 M19.4,15 A1.7,1.7 0 0 0 19.7,16.9 L19.8,17 A2,2 0 1 1 17,19.8 L16.9,19.7 A1.7,1.7 0 0 0 15,19.4 A1.7,1.7 0 0 0 14,21 L14,21.2 A2,2 0 1 1 10,21.2 L10,21 A1.7,1.7 0 0 0 9,19.4 A1.7,1.7 0 0 0 7.1,19.7 L7,19.8 A2,2 0 1 1 4.2,17 L4.3,16.9 A1.7,1.7 0 0 0 4.6,15 A1.7,1.7 0 0 0 3,14 L2.8,14 A2,2 0 1 1 2.8,10 L3,10 A1.7,1.7 0 0 0 4.6,9 A1.7,1.7 0 0 0 4.3,7.1 L4.2,7 A2,2 0 1 1 7,4.2 L7.1,4.3 A1.7,1.7 0 0 0 9,4.6 A1.7,1.7 0 0 0 10,3 L10,2.8 A2,2 0 1 1 14,2.8 L14,3 A1.7,1.7 0 0 0 15,4.6 A1.7,1.7 0 0 0 16.9,4.3 L17,4.2 A2,2 0 1 1 19.8,7 L19.7,7.1 A1.7,1.7 0 0 0 19.4,9 A1.7,1.7 0 0 0 21,10 L21.2,10 A2,2 0 1 1 21.2,14 L21,14 A1.7,1.7 0 0 0 19.4,15 Z" />
                    </Button>
                    <Button x:Name="MinimiseButton" Style="{StaticResource TitleBarButton}" Click="MinimiseButton_Click"
                            ToolTip="Minimise">
                        <Rectangle Width="11" Height="1.6" Fill="{DynamicResource Brush.OnSurfaceVariant}" />
                    </Button>
                    <Button x:Name="MaximiseButton" Style="{StaticResource TitleBarButton}" Click="MaximiseButton_Click"
                            ToolTip="Maximise">
                        <Path x:Name="MaximiseGlyph" Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.6"
                              Stroke="{DynamicResource Brush.OnSurfaceVariant}"
                              Data="M3,4 L20,4 L20,21 L3,21 Z" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click"
                            ToolTip="Close">
                        <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{DynamicResource Brush.OnSurfaceVariant}" Data="M6,6 L18,18 M18,6 L6,18" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Width="228" Background="{DynamicResource Brush.NavigationSurface}"
                    BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="0,0,1,0">
                <Grid Margin="6,14,6,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" x:Name="NavPanel" />

                    <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,14,0,0">
                        <TextBlock x:Name="CategoriesHeader" Margin="14,4,0,6" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.OnSurfaceFaint}" Text="CATEGORIES" />
                        <StackPanel x:Name="CategoryPanel" />
                        <Button x:Name="AddCategoryButton" Margin="8,6,8,0" HorizontalAlignment="Left"
                                Style="{StaticResource Button.Text}" Click="AddCategoryButton_Click" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" x:Name="NavFooterPanel" Margin="8,0,8,0" />
                </Grid>
            </Border>

            <!-- Content host: the background image is painted into BackgroundLayer -->
            <Grid Grid.Column="1">
                <Grid x:Name="BackgroundLayer" />
                <ContentControl x:Name="ContentHost" Margin="0" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource Brush.SurfaceContainerLow}"
                BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" FontSize="11"
                           Foreground="{DynamicResource Brush.OnSurfaceVariant}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusRightText" Grid.Column="1" FontSize="11"
                           Foreground="{DynamicResource Brush.OnSurfaceFaint}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
