<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         Learnest · shared visual language.

         This dictionary holds everything that does not depend on the colour
         scheme: font stacks, control templates and component styles, all of
         which read colours through DynamicResource.  The concrete colour roles
         live in Theme.Light.xaml / Theme.Dark.xaml and are swapped at runtime by
         Theming/ThemeManager.cs, which guarantees a brush for every key used
         here.
         ===================================================================== -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Controls.xaml" />
        <ResourceDictionary Source="/Themes/Window.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Typography -->
    <FontFamily x:Key="Font.Ui">Microsoft YaHei UI, Segoe UI, Segoe UI Variable Text, Malgun Gothic, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

</ResourceDictionary>
